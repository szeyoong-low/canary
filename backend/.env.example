# CORS
ALLOW_ORIGINS=http://localhost:5030,http://127.0.0.1:5030,http://localhost:4173,http://127.0.0.1:4173
ALLOW_ORIGIN_REGEX=

# FMP
FMP_BASE_URL=https://financialmodelingprep.com/stable/
FMP_API_KEY=

# LLM
OPENROUTER_API_KEY=
PLANNING_NODE_MODEL=
PLANNING_NODE_PROVIDER=

# Dev endpoints
DEVELOPMENT=false

# Local container database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=canary

# Database admin
DATABASE_USERNAME=canary_admin
DATABASE_PASSWORD=

# Database runtime
DATABASE_APP_USERNAME=canary_app
DATABASE_APP_PASSWORD=# password | iam. Local development has no IAM, so it is the default.
DATABASE_AUTH=password

# Only read when DATABASE_AUTH=iam
DATABASE_REGION=

# Auth
AUTH0_ISSUER=https://auth.canary.markets/
AUTH0_AUDIENCE=https://api.canary.markets
