        "required": [
          "type"
        ],
        "title": "Axis",
        "type": "object"
      },
      "ByteField": {
        "type": "integer"
      },
      "ChartConfigModel": {
        "additionalProperties": false,
        "properties": {
          "dataset": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Dataset"
            },
            "title": "Dataset",
            "type": "array"
          },
          "legend": {
            "$ref": "#/components/schemas/Legend",
            "default": {
              "data": []
            }
          },
          "series": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Series"
            },
            "title": "Series",
            "type": "array"
          },
          "title": {
            "$ref": "#/components/schemas/Title",
            "default": {
              "text": ""
            }
          },
          "tooltip": {
            "$ref": "#/components/schemas/Tooltip",
            "default": {
              "trigger": "item"
            }
          },
          "xAxis": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Axis"
            },
            "title": "Xaxis",
            "type": "array"
          },
          "yAxis": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Axis"
            },
            "title": "Yaxis",
            "type": "array"
          }
        },
        "title": "ChartConfigModel",
        "type": "object"
      },
      "ColumnarDataset": {
        "additionalProperties": {
          "items": {},
          "type": "array"
        },
        "type": "object"
      },
      "Dataset": {
        "additionalProperties": false,
        "properties": {
          "source": {
            "$ref": "#/components/schemas/DatasetType",
            "default": {}
          }
        },
        "title": "Dataset",
        "type": "object"
      },
      "DatasetType": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/RowObjectDataset"
          },
          {
            "$ref": "#/components/schemas/ColumnarDataset"
          }
        ]
      },
      "DisplayedContentContainer": {
        "properties": {
          "chart": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChartConfigModel"
              },
              {
                "type": "null"
              }
            ]
          },
          "container_id": {
            "format": "uuid",
            "title": "Container Id",
            "type": "string"
          },
          "prose": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prose"
          }
        },
        "required": [
          "container_id",
          "chart",
          "prose"
        ],
        "title": "DisplayedContentContainer",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HexColor": {
        "type": "string"
      },
      "ItemStyle": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RGBA"
              },
              {
                "$ref": "#/components/schemas/HexColor"
              }
            ],
            "default": "#000",
            "title": "Color"
          }
        },
        "title": "ItemStyle",
        "type": "object"
      },
      "Legend": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "default": [],
            "items": {},
            "title": "Data",
            "type": "array"
          }
        },
        "title": "Legend",
        "type": "object"
      },
      "LineStyle": {
        "additionalProperties": false,
        "properties": {
          "cap": {
            "default": "butt",
            "enum": [
              "butt",
              "round",
              "square"
            ],
            "title": "Cap",
            "type": "string"
          },
          "color": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RGBA"
              },
              {
                "$ref": "#/components/schemas/HexColor"
              }
            ],
            "default": "#000",
            "title": "Color"
          },
          "dashOffset": {
            "$ref": "#/components/schemas/NonNegativeInt",
            "default": 0
          },
          "join": {
            "default": "bevel",
            "enum": [
              "bevel",
              "round",
              "miter"
            ],
            "title": "Join",
            "type": "string"
          },
          "type": {
            "default": "solid",
            "enum": [
              "solid",
              "dashed",
              "dotted"
            ],
            "title": "Type",
            "type": "string"
          },
          "width": {
            "$ref": "#/components/schemas/NonNegativeInt",
            "default": 2
          }
        },
        "title": "LineStyle",
        "type": "object"
      },
      "MinimumReportRole": {
        "$ref": "#/components/schemas/ReportRoleName"
      },
      "NonEmptyString": {
        "type": "string"
      },
      "NonNegativeInt": {
        "type": "integer"
      },
      "NormalisedFloatField": {
        "type": "number"
      },
      "Params": {
        "additionalProperties": true,
        "type": "object"
      },
      "PromptBody": {
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "$ref": "#/components/schemas/NonEmptyString",
            "maxLength": 2000
          }
        },
        "required": [
          "prompt"
        ],
        "title": "PromptBody",
        "type": "object"
      },
      "RGBA": {
        "additionalProperties": false,
        "properties": {
          "alpha": {
            "$ref": "#/components/schemas/NormalisedFloatField",
            "default": 1
          },
          "blue": {
            "$ref": "#/components/schemas/ByteField",
            "default": 0
          },
          "green": {
            "$ref": "#/components/schemas/ByteField",
            "default": 0
          },
          "red": {
            "$ref": "#/components/schemas/ByteField",
            "default": 0
          }
        },
        "title": "RGBA",
        "type": "object"
      },
      "ReportFull": {
        "properties": {
          "authors": {
            "items": {
              "$ref": "#/components/schemas/NonEmptyString"
            },
            "title": "Authors",
            "type": "array"
          },
          "content_containers": {
            "items": {
              "$ref": "#/components/schemas/DisplayedContentContainer"
            },
            "title": "Content Containers",
            "type": "array"
          },
          "public": {
            "title": "Public",
            "type": "boolean"
          },
          "title": {
            "$ref": "#/components/schemas/NonEmptyString"
          }
        },
        "required": [
          "title",
          "authors",
          "public",
          "content_containers"
        ],
        "title": "ReportFull",
        "type": "object"
      },
      "ReportPreview": {
        "properties": {
          "authors": {
            "items": {
              "$ref": "#/components/schemas/NonEmptyString"
            },
            "title": "Authors",
            "type": "array"
          },
          "chart": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChartConfigModel"
              },
              {
                "type": "null"
              }
            ]
          },
          "report_id": {
            "format": "uuid",
            "title": "Report Id",
            "type": "string"
          },
          "title": {
            "$ref": "#/components/schemas/NonEmptyString"
          }
        },
        "required": [
          "title",
          "authors",
          "report_id",
          "chart"
        ],
        "title": "ReportPreview",
        "type": "object"
      },
      "ReportPreviewPage": {
        "description": "One page of a gallery, and how to ask for the next.",
        "properties": {
          "next_cursor": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "previews": {
            "items": {
              "$ref": "#/components/schemas/ReportPreview"
            },
            "title": "Previews",
            "type": "array"
          }
        },
        "required": [
          "previews",
          "next_cursor"
        ],
        "title": "ReportPreviewPage",
        "type": "object"
      },
      "ReportRoleName": {
        "enum": [
          "viewer",
          "commenter",
          "editor",
          "owner"
        ],
        "type": "string"
      },
      "ReportTitle": {
        "additionalProperties": false,
        "properties": {
          "title": {
            "$ref": "#/components/schemas/NonEmptyString"
          }
        },
        "required": [
          "title"
        ],
        "title": "ReportTitle",
        "type": "object"
      },
      "ReportVisibility": {
        "additionalProperties": false,
        "properties": {
          "public": {
            "title": "Public",
            "type": "boolean"
          }
        },
        "required": [
          "public"
        ],
        "title": "ReportVisibility",
        "type": "object"
      },
      "RowObjectDataset": {
        "items": {
          "$ref": "#/components/schemas/Params"
        },
        "type": "array"
      },
      "Series": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "encode": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Encode"
          },
          "itemStyle": {
            "$ref": "#/components/schemas/ItemStyle",
            "default": {
              "color": "#000"
            }
          },
          "lineStyle": {
            "$ref": "#/components/schemas/LineStyle",
            "default": {
              "cap": "butt",
              "color": "#000",
              "dashOffset": 0,
              "join": "bevel",
              "type": "solid",
              "width": 2
            }
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "showSymbol": {
            "default": true,
            "title": "Showsymbol",
            "type": "boolean"
          },
          "type": {
            "$ref": "#/components/schemas/SeriesType"
          },
          "yAxisIndex": {
            "default": 0,
            "title": "Yaxisindex",
            "type": "integer"
          }
        },
        "required": [
          "type"
        ],
        "title": "Series",
        "type": "object"
      },
      "SeriesType": {
        "enum": [
          "line",
          "bar",
          "pie",
          "scatter",
          "effectScatter",
          "radar",
          "tree",
          "treemap",
          "sunburst",
          "boxplot",
          "candlestick",
          "heatmap",
          "map",
          "parallel",
          "lines",
          "graph",
          "sankey",
          "funnel",
          "gauge",
          "pictorialBar",
          "themeRiver",
          "chord",
          "custom"
        ],
        "type": "string"
      },
      "Title": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "default": "",
            "title": "Text",
            "type": "string"
          }
        },
        "title": "Title",
        "type": "object"
      },
      "Tooltip": {
        "additionalProperties": false,
        "properties": {
          "trigger": {
            "default": "item",
            "enum": [
              "item",
              "axis",
              "none"
            ],
            "title": "Trigger",
            "type": "string"
          }
        },
        "title": "Tooltip",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/reports/": {
      "post": {
        "description": "Open an empty report owned by the caller and private to them.\n\nNothing is returned but the `Location` of the new report, which is all the\nfrontend needs to navigate to it.",
        "operationId": "create_new_report",
        "responses": {
          "201": {
            "description": "Successful Response",
            "headers": {
              "Location": {
                "description": "Where the newly created report can be found.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create New Report"
      }
    },
    "/reports/previews": {
      "get": {
        "description": "One page of report previews, newest first.\n\nThe two criteria are a union, not an intersection.\n\n`cursor` is the `report_id` of the last preview already held. Omit it for\nthe first page, and stop when the response carries no `next_cursor`.",
        "operationId": "list_report_previews",
        "parameters": [
          {
            "in": "query",
            "name": "public",
            "required": false,
            "schema": {
              "default": false,
              "title": "Public",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "minimum_report_role",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/MinimumReportRole"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Minimum Report Role"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 10,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportPreviewPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Report Previews"
      }
    },
    "/reports/{report_id}": {
      "get": {
        "description": "Read one report in full: its metadata and every container mounted in it.\n\nA report that does not exist, or that this caller may not read, never\nreaches this body. The guard above answers both.",
        "operationId": "get_specific_report",
        "parameters": [
          {
            "in": "path",
            "name": "report_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Report Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportFull"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Specific Report"
      }
    },
    "/reports/{report_id}/contents": {
      "post": {
        "operationId": "add_generated_content_to_report",
        "parameters": [
          {
            "in": "path",
            "name": "report_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Report Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "position",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/NonNegativeInt"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Position"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromptBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisplayedContentContainer"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Add Generated Content To Report"
      }
    },
    "/reports/{report_id}/title": {
      "put": {
        "description": "Retitle a report.\n\nA 204 is enough to confirm it: the caller already knows the title it sent,\nso returning the report again would only waste bandwidth.",
        "operationId": "rename_specific_report",
        "parameters": [
          {
            "in": "path",
            "name": "report_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Report Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportTitle"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Rename Specific Report"
      }
    },
    "/reports/{report_id}/visibility": {
      "put": {
        "description": "Publish a report to everyone, or take it private again.\n\nThe caller is recorded alongside the flip: `report_visibility` is an\nappend-only history, and who published a report is part of what it answers.",
        "operationId": "publish_or_unpublish_report",
        "parameters": [
          {
            "in": "path",
            "name": "report_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Report Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportVisibility"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Publish Or Unpublish Report"
      }
    }
  }
}
